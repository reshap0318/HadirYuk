# ═══════════════════════════════════════════════════════════════
#  HadirYuk — Docker Environment
#  Salin ke .env dan sesuaikan nilainya
#  ONE FILE untuk semua config — tidak perlu edit docker-compose
# ═══════════════════════════════════════════════════════════════

# ── Timezone ────────────────────────────────────────────────────
TZ=Asia/Jakarta

# ── Database (MySQL container) ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hadir_yuk
DB_USERNAME=root
DB_PASSWORD=

# ── Redis (Redis container) ─────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── App Server ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:9010/be
APP_FE_URL=http://localhost:9010
ALLOWED_ORIGINS=*
TRUSTED_PROXIES=*
GIN_MODE=debug

# ── JWT (RS256) ─────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_PASSPHRASE=
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=168

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── SMTP (optional — untuk password reset) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Frontend (Vite) ─────────────────────────────────────────────
VITE_API_BASE_URL=/be/api
VITE_APP_NAME=HadirYuk
VITE_BACKEND_URL=http://backend:8080
