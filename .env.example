# ═══════════════════════════════════════════════════════════════
#  HadirYuk — Docker Environment
#  Salin ke .env dan sesuaikan nilainya
#  ONE FILE untuk semua config — tidak perlu edit docker-compose
# ═══════════════════════════════════════════════════════════════

# ── Timezone ────────────────────────────────────────────────────
TZ=Asia/Jakarta
UID=1000
GID=1000

# ── Database (MySQL container) ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hadir_yuk
DB_USERNAME=root
DB_PASSWORD=

# ── Redis (Redis container) ─────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── App Server ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:9010/be
APP_FE_URL=http://localhost:9010
ALLOWED_ORIGINS=*
TRUSTED_PROXIES=*
GIN_MODE=debug

# ── JWT (RS256) ─────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=storage/keys/private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/public.pem
JWT_PASSPHRASE_PATH=storage/keys/passphrase
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=168

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── SMTP (optional — untuk password reset) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── AI Chatbot ─────────────────────────────────────────────
# OpenAI: leave AI_CHAT_BASE_URL empty, set AI_CHAT_API_KEY to your OpenAI key.
# DeepSeek: AI_CHAT_BASE_URL=https://api.deepseek.com, AI_CHAT_MODEL=deepseek-v4-flash (cheapest, tool-calling capable).
# Ollama: AI_CHAT_BASE_URL=https://ollama.com/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_BASE_URL=
AI_CHAT_DB_USERNAME=
AI_CHAT_DB_PASSWORD=
AI_CHAT_QUERY_TIMEOUT_SECONDS=10
AI_CHAT_MAX_ROWS=100
AI_CHAT_SESSION_TTL_MINUTES=1440
AI_CHAT_MAX_STORED_MESSAGES=100
AI_CHAT_MAX_CONTEXT_MESSAGES=10
AI_CHAT_RATE_LIMIT_GLOBAL_MAX=200
AI_CHAT_RATE_LIMIT_USER_MAX=20

# ── Frontend (Vite) ─────────────────────────────────────────────
VITE_API_BASE_URL=/be/api
VITE_APP_NAME=HadirYuk
VITE_BACKEND_URL=http://backend:8080