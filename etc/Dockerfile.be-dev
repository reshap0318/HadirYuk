# ── Development Backend ──────────────────────────────────────────
# Go dev image with air for hot-reload.
# Cron binaries (markabsent, cleartmp) dibangun saat image build dan
# ditempatkan di /markabsent & /cleartmp (di luar /app) sehingga tidak
# tertimpa oleh volume mount ./be:/app saat runtime.
# ──────────────────────────────────────────────────────────────────

FROM golang:1.25-alpine

RUN apk add --no-cache git gcc musl-dev tzdata

# Set system timezone so busybox crond uses local time correctly
RUN cp /usr/share/zoneinfo/Asia/Jakarta /etc/localtime && \
    echo "Asia/Jakarta" > /etc/timezone

# Install air
RUN go install github.com/air-verse/air@latest

ENV GOCACHE=/tmp/go-build
ENV GOPATH=/tmp/gopath

WORKDIR /app

COPY be/go.mod be/go.sum ./
RUN go mod download

# Copy source to build cron binaries.
# Binaries ditempatkan di root (/) — tidak tertimpa volume mount /app.
COPY be/ .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -tags timetzdata -o /markabsent ./cmd/markabsent && \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /cleartmp ./cmd/cleartmp

RUN rm -rf /tmp/go-build /tmp/gopath

COPY etc/entrypoint-dev.sh /entrypoint.sh
COPY etc/crontab           /etc/crontabs/root

RUN chmod +x /entrypoint.sh && mkdir -p /var/log && mkdir -p /app/tmp && chmod 1777 /app/tmp

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
