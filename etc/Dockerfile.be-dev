# ── Development Backend ──────────────────────────────────────────
# Go dev image with air for hot-reload
# ──────────────────────────────────────────────────────────────────

FROM golang:1.25-alpine

RUN apk add --no-cache git gcc musl-dev tzdata

# Install air
RUN go install github.com/air-verse/air@latest

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
