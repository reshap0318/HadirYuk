# ── Development Backend ──────────────────────────────────────────
# Go dev image with air for hot-reload
# ──────────────────────────────────────────────────────────────────

FROM golang:1.25-alpine

RUN apk add --no-cache git gcc musl-dev tzdata

# Install air
RUN go install github.com/air-verse/air@latest

WORKDIR /app

COPY be/go.mod be/go.sum ./
RUN go mod download

COPY etc/entrypoint-dev.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
