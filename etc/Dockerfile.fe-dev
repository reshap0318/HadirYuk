# ── Development Frontend ─────────────────────────────────────────
# Node dev image with Vite dev server
# ──────────────────────────────────────────────────────────────────

FROM node:22-alpine

WORKDIR /app

COPY fe/package.json fe/package-lock.json ./

RUN npm install

EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]
